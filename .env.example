# ============================================================================
# AI Trading Intelligence — Environment Configuration Example
# Copy to `.env` for local overrides. NEVER commit real secrets to Git.
# The application works out-of-the-box in Offline Deterministic Mode with zero keys.
# ============================================================================

# --- Server & Proxy Routing ---
# Next.js server-side proxy destination for `/api/*` requests
PYTHON_BACKEND_URL=http://127.0.0.1:8000
TI_API_HOST=0.0.0.0
TI_API_PORT=8000

# --- Storage & Upload Constraints ---
TI_DB_PATH=./data/trading_intel.db
TI_UPLOAD_DIR=./data/uploads
TI_MAX_UPLOAD_MB=10

# --- Optional Multimodal AI Vision Providers (Server-side only) ---
# Configure EITHER Google Gemini OR an OpenAI-compatible Vision API to automatically
# extract ticker, timeframe, candles, and price axis values from chart screenshots.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Optional Authorized Market Data Provider ---
# Supported built-in adapter: `alphavantage`
# When unconfigured, live market quotes are hidden rather than simulated.
TI_MARKET_DATA_PROVIDER=
TI_MARKET_DATA_KEY=

# --- Optional Authorized Financial News Provider ---
# Supported built-in adapter: `newsapi`
# When unconfigured, news feeds explicitly state unavailability; zero headlines are invented.
TI_NEWS_PROVIDER=
TI_NEWS_KEY=

# --- Optional SMTP for Email Password Reset Delivery ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
